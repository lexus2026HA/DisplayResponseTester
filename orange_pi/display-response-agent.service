[Unit]
Description=DisplayResponseAgent optical capture
After=network.target

[Service]
Type=simple
User=display-response
SupplementaryGroups=video
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/usr/bin/python3 /opt/display-response-agent/server.py --bind 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target